# Dependencies
node_modules

# Build output. `.wxt` is WXT's generated project (types, entrypoint wrappers).
build
.wxt
# `pnpm build` writes the Worker's dry-run bundle here.
.worker-build

# Local Cloudflare state: Miniflare's DO simulator lives here.
.wrangler

# Secrets. `.dev.vars` is the local equivalent of `wrangler secret put`.
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example
*.local
# Left over from the Cloudflare Access era (ADR 0001): a private signing key
# that nothing reads any more. Ignored rather than merely deleted, so a stale
# copy in someone's checkout cannot be committed by accident.
e2e/.dev-key.json

# The manifest key's private half. The public half is committed in
# wxt.config.ts on purpose: it pins the extension id across Chrome and Canary.
*.pem

# Test and coverage artefacts. Playwright baselines are NOT ignored: they live
# in e2e/__screenshots__ and are reviewed like source.
coverage
playwright-report
test-results
playwright/.cache

# Editor and OS noise
.DS_Store
*.log
